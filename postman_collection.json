    {
      "name": "8. POST Kirim Pesan Kontak (Valid - 201 Created)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sender_name\": \"Alexander Graham\",\n  \"sender_email\": \"alexander@techcorp.com\",\n  \"subject\": \"Tawaran Kolaborasi Proyek Full-Stack Web\",\n  \"body\": \"Halo Revaliano, kami sangat terkesan dengan portofolio web dan desain UI/UX Anda. Kami ingin menawarkan kesempatan kerja sama proyek sistem informasi perusahaan kami.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/portfolio/messages",
          "host": ["{{base_url}}"],
          "path": ["api", "portfolio", "messages"]
        },
        "description": "Mengirimkan pesan kontak yang valid melalui FormRequest. Mengharapkan status 201 Created."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response success is true with message data\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "    pm.expect(jsonData.data.sender_name).to.eql(\"Alexander Graham\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. POST Kirim Pesan Kontak (Gagal Validasi - 422 Unprocessable Entity)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sender_name\": \"Al\",\n  \"sender_email\": \"bukan-email-yang-benar\",\n  \"subject\": \"\",\n  \"body\": \"pendek\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/portfolio/messages",
          "host": ["{{base_url}}"],
          "path": ["api", "portfolio", "messages"]
        },
        "description": "Mengirimkan data tidak valid (nama terlalu pendek, email salah format, body kurang dari 10 karakter). Mengharapkan status 422 Unprocessable Entity."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 422 Unprocessable Entity\", function () {",
              "    pm.response.to.have.status(422);",
              "});",
              "pm.test(\"Response success is false with error details\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.false;",
              "    pm.expect(jsonData).to.have.property('errors');",
              "    pm.expect(jsonData.errors).to.have.property('sender_name');",
              "    pm.expect(jsonData.errors).to.have.property('sender_email');",
              "    pm.expect(jsonData.errors).to.have.property('body');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. POST Kirim Pesan Kontak (Alias Endpoint /api/messages)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
