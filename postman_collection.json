            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Siti Rahmawati\",\n  \"email\": \"siti.rahma@company.com\",\n  \"subject\": \"Pertanyaan Layanan Pembuatan Web\",\n  \"content\": \"Halo, saya ingin menanyakan estimasi biaya dan waktu pengerjaan untuk website portofolio interaktif serupa.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/messages",
          "host": ["{{base_url}}"],
          "path": ["api", "messages"]
        },
        "description": "Menguji pengiriman pesan menggunakan alias parameter (name, email, content) yang dinormalisasi otomatis oleh FormRequest."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response success is true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "});"
            ]
          }
        }
      ]
    }
  ]
